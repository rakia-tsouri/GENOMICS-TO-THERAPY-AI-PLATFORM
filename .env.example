# Copy to .env and adjust. docker-compose reads these.

# --- Postgres ---
POSTGRES_USER=gtt
POSTGRES_PASSWORD=gtt
POSTGRES_DB=gtt

# --- Gateway auth ---
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# --- Demo seeding (set SEED_DEMO=false to disable in production) ---
SEED_DEMO=true
DEMO_ADMIN_EMAIL=admin@medconnect.dev
DEMO_ADMIN_PASSWORD=admin12345
DEMO_RESEARCHER_EMAIL=researcher@medconnect.dev
DEMO_RESEARCHER_PASSWORD=research12345

# --- CORS / frontend ---
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
